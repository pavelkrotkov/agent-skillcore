#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${AGENT_SKILLFLEET_ROOT:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
PYTHON="${AGENT_SKILLFLEET_PYTHON:-$ROOT/.venv/bin/python}"
[ -x "$PYTHON" ] || PYTHON=python3
exec "$PYTHON" "$ROOT/src/agent_skillfleet/cli.py" --repo "$ROOT" update "$@"
