#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${AGENT_SKILLFLEET_ROOT:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
PYTHON="${AGENT_SKILLFLEET_PYTHON:-}"
if [[ -z "$PYTHON" ]]; then
  if [[ -x "$ROOT/.venv/bin/python" ]]; then PYTHON="$ROOT/.venv/bin/python"; else PYTHON="python3"; fi
fi
exec "$PYTHON" "$ROOT/src/agent_skillfleet/cli.py" --repo "$ROOT" validate "$@"
