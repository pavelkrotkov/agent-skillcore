[Unit]
Description=Expire redundant x-curator builds, caches and staging copies
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5m
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/x-curator-fresh/runtime.env
ExecStart=%h/.local/state/x-curator-runtime/bin/python -m x_curator --state ${CURATOR_STATE} retain --apply
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state
StandardOutput=null
StandardError=journal
