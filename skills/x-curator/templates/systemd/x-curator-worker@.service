[Unit]
Description=One bounded fresh X quick-check worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/x-curator-fresh/runtime.env
ExecStart=%h/.local/state/x-curator-runtime/bin/python -m x_curator --state ${CURATOR_STATE} work --max-items 1 --lease-seconds 240 --defer-index --unspent-only
ExecStartPost=/usr/bin/systemctl --user --no-block start x-curator-index.service
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state %h/.cache %h/.codex
StandardOutput=append:%h/.local/state/x-curator-fresh/worker-%i.log
StandardError=append:%h/.local/state/x-curator-fresh/worker-%i-errors.log
