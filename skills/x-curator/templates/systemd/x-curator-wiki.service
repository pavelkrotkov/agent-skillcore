[Unit]
Description=Private current X wiki browser
After=network.target

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/x-curator-fresh/runtime.env
ExecStart=%h/.local/state/x-curator-runtime/bin/python -m x_curator.wiki_http ${CURATOR_STATE}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
