[Unit]
Description=Fresh private X intake and verified index
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/x-curator-fresh/runtime.env
ExecStart=%h/.local/state/x-curator-runtime/bin/python -m x_curator --state ${CURATOR_STATE} supervise --max-items 0 --max-sources 0 --seconds 3500
TimeoutStartSec=3650
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state %h/.cache %h/.codex
StandardOutput=append:%h/.local/state/x-curator-fresh/operations.log
StandardError=append:%h/.local/state/x-curator-fresh/errors.log
